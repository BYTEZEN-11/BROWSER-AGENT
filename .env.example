# LangGraph Browser Agent - Environment Configuration
# Copy this file to .env and fill in your values

# OpenAI Configuration
OPENAI_MODEL=gpt-4-turbo
OPENAI_MAX_TOKENS=4096

# Flask Configuration
SECRET_KEY=your-secret-key-here-use-random-string
DEBUG=False

# Server Configuration
HOST=0.0.0.0
PORT=8080
MAX_CONTENT_LENGTH=16777216

# Agent Configuration
DEFAULT_MAX_STEPS=50
MIN_MAX_STEPS=10
MAX_MAX_STEPS=150

# Browser Configuration
BROWSER_HEADLESS=True
BROWSER_TIMEOUT=30000

# Logging
LOG_LEVEL=INFO
LOG_FILE=browser_agent.log

# Application Info
APP_NAME=LangGraph Browser Agent
APP_VERSION=1.0.0
APP_DESCRIPTION=AI-Powered Web Automation
